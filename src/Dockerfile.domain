FROM node:24.11.1-bookworm-slim@sha256:48abc13a19400ca3985071e287bd405a1d99306770eb81d61202fb6b65cf0b57
RUN mkdir -p /data && chown node:node /data
WORKDIR /app
COPY --chown=node:node domain-store.mjs domain-service.mjs ./
USER node
ENV NODE_ENV=production DOMAIN_DB=/data/domain.sqlite PORT=4176
CMD ["node", "domain-service.mjs"]
