    {
      "kind": "request",
      "text": "Help me plan my study time for the Applied Data Ethics case memo over the next two weeks. Which deadline should we plan around? I have a module outline and a learning platform export. Check my calendar and ask what times work for me before making a proposal."
    },
    {
      "kind": "question",
      "id": "weekly_target_hours",
      "text": "How many hours per week do you want to target for Applied Data Ethics study over 2–15 November?",
      "choices": [
        "5 hours per week",
        "8 hours per week",
        "10 hours per week",
        "12 hours per week"
      ]
    },
    {
      "kind": "question",
      "id": "max_daily_study_hours",
      "text": "What is the maximum study time per day? Study blocks are 1 hour each, so this is also the maximum number of sessions per day.",
      "choices": [
        "1 hour per day",
        "2 hours per day",
        "3 hours per day",
        "4 hours per day"
      ]
    },
    {
      "kind": "question",
      "id": "study_break_minutes",
      "text": "How many minutes of break do you want between 1-hour study blocks?",
      "choices": [
        "0 minutes",
        "10 minutes",
        "15 minutes",
        "30 minutes"
      ]
    },
    {
      "kind": "question",
      "id": "preferred_study_window",
      "text": "Which recurring study window works best, given work 08:00–12:00, lunch 12:00–13:00, class Mon/Wed/Thu from 18:30, and Thursday exercise 16:30–17:30?",
      "choices": [
        "Monday to Friday 13:00–15:00",
        "Monday to Friday 13:00–16:00",
        "Monday to Friday 15:00–17:00",
        "Tuesday and Friday 18:00–21:00 plus Saturday 10:00–13:00"
      ]
    },
    {
      "kind": "answer",
      "questionId": "weekly_target_hours",
      "text": "Four study hours a week feels workable, with no more than two sessions a day and a 15-minute break between them."
    },
    {
      "kind": "answer",
      "questionId": "max_daily_study_hours",
      "text": "For these two weeks, Wednesday, Thursday and Friday from 14:00 to 16:15 can work when the calendar is clear. I prefer to keep the weekend open."
    },
    {
      "kind": "answer",
      "questionId": "study_break_minutes",
      "text": "I picked a case but haven't written an outline. I don't know how much time it will take yet."
    },
